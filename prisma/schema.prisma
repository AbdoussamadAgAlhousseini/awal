// Awal — modèle de données (MVP dictionnaire v0.1)
// Aligné sur §21 du dossier de conception. SQLite en dev, portable vers PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

/// Aire dialectale (Mali, Niger, Algérie, Libye, Burkina Faso)
model Area {
  id       String    @id
  code     String    @unique // ex. taq-ML
  country  String
  name     String
  geojson  String? // polygone indicatif de l'aire, pour l'atlas (§15)
  variants Variant[]
  speakers Speaker[]
  articles Article[]
}

/// Racine consonantique (√)
model Root {
  id       String   @id @default(cuid())
  radicals String   @unique // ex. M-N
  notes    String?
  lexemes  Lexeme[]
}

/// Entrée lexicale — objet central du dictionnaire
model Lexeme {
  id        String    @id @default(cuid())
  headword  String // forme vedette (latin normalisé)
  tifinagh  String
  ipa       String?
  pos       String // catégorie grammaticale
  gender    String?
  number    String?
  register  String? // registre / niveau de langue
  frequency String? // fréquence d'usage
  etymology String?
  phonetic  String    @default("") // squelette consonantique — recherche phonétique (§13)
  rootId    String?
  root      Root?     @relation(fields: [rootId], references: [id])
  senses    Sense[]
  variants  Variant[]
  media     Media[]
  verbStems VerbStem[]
  articles  ArticleLexeme[]
  contributions Contribution[]
  status    String    @default("published") // draft | review | published | archived
  createdAt DateTime  @default(now())

  @@index([headword])
  @@index([phonetic])
}

/// Radical d'un verbe pour un aspect donné — nourrit le conjugueur (§12).
/// `attested` distingue une forme relevée en corpus d'une forme proposée à valider.
model VerbStem {
  id       String  @id @default(cuid())
  lexemeId String
  lexeme   Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  aspect   String // aoriste | accompli | inaccompli | accompli_negatif
  stem     String
  attested Boolean @default(false)
  source   String?

  @@unique([lexemeId, aspect])
}

/// Compte contributeur (identité pseudonyme — l'auth OAuth2/OIDC est prévue en v1.0, §25)
model User {
  id            String         @id @default(cuid())
  pseudonym     String         @unique
  role          String         @default("contributor") // contributor | moderator
  reputation    Int            @default(0)
  createdAt     DateTime       @default(now())
  contributions Contribution[] @relation("author")
  reviews       Contribution[] @relation("reviewer")
}

/// Proposition soumise par un contributeur, en attente de validation (§18)
model Contribution {
  id         String    @id @default(cuid())
  kind       String // new_lexeme | example | variant
  status     String    @default("pending") // pending | approved | rejected
  payload    String // JSON de la proposition
  note       String? // commentaire du contributeur
  authorId   String
  author     User      @relation("author", fields: [authorId], references: [id])
  lexemeId   String? // entrée visée (null pour un mot nouveau)
  lexeme     Lexeme?   @relation(fields: [lexemeId], references: [id], onDelete: SetNull)
  reviewerId String?
  reviewer   User?     @relation("reviewer", fields: [reviewerId], references: [id])
  reviewNote String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status])
}

/// Journal d'audit : toute écriture métier est historisée et réversible (§21, §25)
model Revision {
  id        String   @id @default(cuid())
  entity    String // lexeme | sense | example | variant
  entityId  String
  action    String // create | update | delete
  payload   String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

/// Acception (un mot peut avoir plusieurs sens)
model Sense {
  id           String    @id @default(cuid())
  lexemeId     String
  lexeme       Lexeme    @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  order        Int       @default(1)
  defShort     String
  defLong      String?
  translations String? // JSON: {"fr":"...","en":"...","ar":"..."}
  examples     Example[]

  @@index([lexemeId])
}

/// Exemple d'usage attesté
model Example {
  id          String  @id @default(cuid())
  senseId     String
  sense       Sense   @relation(fields: [senseId], references: [id], onDelete: Cascade)
  text        String
  translation String?
  sourceId    String?
  source      Source? @relation(fields: [sourceId], references: [id])
}

/// Forme d'un lexème dans une aire dialectale donnée
model Variant {
  id       String @id @default(cuid())
  lexemeId String
  lexeme   Lexeme @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  areaId   String
  area     Area   @relation(fields: [areaId], references: [id])
  form     String
  ipa      String?

  @@unique([lexemeId, areaId])
}

/// Média rattaché à une entrée (audio, image, vidéo)
model Media {
  id        String   @id @default(cuid())
  lexemeId  String
  lexeme    Lexeme   @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  kind      String // audio | image | video
  uri       String
  license   String?
  ipa       String?
  speakerId String?
  speaker   Speaker? @relation(fields: [speakerId], references: [id])
}

/// Locuteur ayant fourni un enregistrement (pseudonyme + consentement)
model Speaker {
  id         String  @id @default(cuid())
  pseudonym  String
  areaId     String?
  area       Area?   @relation(fields: [areaId], references: [id])
  consent    Boolean @default(false)
  media      Media[]
}

/// Source bibliographique
model Source {
  id         String    @id @default(cuid())
  citation   String
  type       String?
  url        String?
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  examples   Example[]
}

/// Fiche encyclopédique culturelle (§9)
model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  body      String
  category  String // histoire | oralite | musique | artisanat | pastoralisme | habitat | cosmologie | coutume | nature
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id])
  /// Régime d'accès CARE (§9) : « public » ou « restricted » lorsque le savoir est
  /// sensible (généalogies, droit coutumier, médecine) et requiert le consentement
  /// des détenteurs avant diffusion.
  sensitivity String @default("public")
  restrictionNote String?
  status    String   @default("published") // draft | review | published | archived
  createdAt DateTime @default(now())

  lexemes   ArticleLexeme[]
  documents ArticleDocument[]

  @@index([category])
}

/// Termes du lexique traités dans une fiche encyclopédique
model ArticleLexeme {
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  lexemeId  String
  lexeme    Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@id([articleId, lexemeId])
}

/// Document de la bibliothèque numérique (§16)
model Document {
  id          String  @id @default(cuid())
  title       String
  author      String?
  year        String?
  kind        String // livre | article | manuscrit | audio | video | archive
  language    String?
  description String?
  /// Régime de droits : « open » (librement consultable), « restricted » (consultation
  /// encadrée), « unknown » (à clarifier avant toute diffusion).
  rights      String  @default("unknown")
  rightsNote  String?
  url         String?
  /// Manifeste IIIF — le champ existe, mais aucune visionneuse n'est branchée
  /// tant qu'il n'y a pas de documents numérisés ni de serveur d'images.
  iiifManifest String?
  createdAt   DateTime @default(now())

  sources   Source[]
  articles  ArticleDocument[]

  @@index([kind])
}

model ArticleDocument {
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([articleId, documentId])
}
