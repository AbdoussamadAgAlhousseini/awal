# ─────────────────────────────────────────────────────────────────────────────
# Awal — configuration. Copiez ce fichier en .env.local (jamais versionné).
# Pour la mise en ligne, ces mêmes variables se règlent dans le tableau de bord
# Vercel (Settings → Environment Variables). Voir DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données PostgreSQL — REQUIS ──────────────────────────────────────
# Depuis Neon (https://neon.tech), copiez les deux chaînes de connexion :
#   DATABASE_URL = connexion « Pooled » (utilisée par l'application)
#   DIRECT_URL   = connexion « Direct » (utilisée par les migrations / db push)
DATABASE_URL=
DIRECT_URL=

# ── Authentification réelle (§25) ────────────────────────────────────────────
# Secret de signature des sessions. Générez-le avec :  openssl rand -base64 32
AUTH_SECRET=

# URL publique de l'application (en production, ex. https://awal.vercel.app).
# En développement local, laissez vide : Auth.js déduit http://localhost:3000.
AUTH_URL=

# Fournisseurs OAuth. Renseignez-en AU MOINS UN pour activer l'authentification.
# URL de rappel à déclarer chez le fournisseur :
#   <AUTH_URL>/api/auth/callback/<fournisseur>
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Droits de validation ─────────────────────────────────────────────────────
# Adresses autorisées à valider les contributions, séparées par des virgules.
# Réévalué à chaque connexion : retirer une adresse retire le droit.
AWAL_MODERATOR_EMAILS=

# ── Mode prototype uniquement ────────────────────────────────────────────────
# Code accordant le rôle de valideur SANS authentification. Sans effet dès qu'un
# fournisseur OAuth est configuré. À NE PAS utiliser en production.
AWAL_MODERATOR_CODE=
