# ─────────────────────────────────────────────────────────────────────────────
# Awal — configuration. Copiez ce fichier en .env.local (jamais versionné).
#
# TOUTES LES VALEURS SONT VIDES À DESSEIN.
# Tant qu'aucun fournisseur d'identité n'est renseigné, la plateforme fonctionne
# en MODE PROTOTYPE : identité pseudonyme sans mot de passe, qui n'authentifie
# personne. Ce mode ne doit pas être mis en ligne publiquement.
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentification réelle (§25) ────────────────────────────────────────────
# Secret de signature des sessions. Générez-le avec :  openssl rand -base64 32
AUTH_SECRET=

# URL publique de l'application (requise en production).
# En développement, Auth.js déduit http://localhost:3000.
AUTH_URL=

# Fournisseurs OAuth. Renseignez-en AU MOINS UN pour activer l'authentification.
# L'URL de rappel à déclarer chez le fournisseur est :
#   <AUTH_URL>/api/auth/callback/<fournisseur>
#   ex. http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Droits de validation ─────────────────────────────────────────────────────
# Adresses autorisées à valider les contributions, séparées par des virgules.
# Le rôle est réévalué à chaque connexion : retirer une adresse retire le droit.
AWAL_MODERATOR_EMAILS=

# ── Mode prototype uniquement ────────────────────────────────────────────────
# Code accordant le rôle de valideur SANS authentification. Sans effet dès qu'un
# fournisseur OAuth est configuré. À ne pas utiliser en production : un code se
# transmet et ne prouve rien sur l'identité de qui l'emploie.
AWAL_MODERATOR_CODE=
